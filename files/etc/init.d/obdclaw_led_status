#!/bin/sh /etc/rc.common

# The target init runner only scans S?? links.  S99 sorts after
# S99blue_led_fix, so this daemon owns the final red/blue runtime state.
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/obdclaw_led_status
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
