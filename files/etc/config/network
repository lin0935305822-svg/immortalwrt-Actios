config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd00:db80::/48'

# 1. 本地 USB RNDIS 虚拟网卡管理接口 (usb0)
# Keep this separate from the Wi-Fi AP LAN.  Sharing the interface name made
# the fallback AP come up without an address or DHCP server.
config interface 'usb_rndis'
	option device 'usb0'
	option proto 'static'
	option ipaddr '192.168.41.2'
	option netmask '255.255.255.0'

# 2. Wi-Fi AP management LAN.  wlan AP interfaces are attached to this empty
# bridge by netifd; eth0 remains dedicated to the DoIP diagnostic network.
config device
	option name 'br-lan'
	option type 'bridge'
	option bridge_empty '1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option force_link '1'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'

# 3. 宝马 DoIP 诊断物理以太网网口 (eth0)
# 静态 IP 充当网关，避免未连线时 udhcpc 阻塞开机，符合 QUALCOMM_410_RJ45_DHCP_AND_BMW_DOIP_SPEC.md 规范
config interface 'diag_lan'
	option device 'eth0'
	option proto 'static'
	option ipaddr '192.168.20.1'
	option netmask '255.255.255.0'

# 4. 无线 STA 客户端接口 (wlan0)
# 仅在物理 Wi-Fi 握手关联手机热点成功后激活 DHCP 申请，开机无网时不阻塞引导，符合 QUALCOMM_410_WIFI_STATION_NO_4G_SPEC.md 规范
config interface 'wifi_sta'
	option proto 'dhcp'

# 5. 4G 旁路 Modem 接口 (wwan0)
# 强制关闭默认路由注入与转发，符合 QUALCOMM_410_WIFI_STATION_NO_4G_SPEC.md 中的风控隔离规范
config interface 'wwan'
	option proto 'dhcp'
	option defaultroute '0'
	option metric '99'
