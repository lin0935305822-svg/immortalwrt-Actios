#!/bin/sh
# The production station is an untrusted uplink.  Expose only the pinned TLS
# control API to peers on the configured TP-LINK LAN; keep all other input,
# including HTTP/80, rejected.
if command -v uci >/dev/null 2>&1 && [ -f /etc/config/firewall ]; then
    uci -q delete firewall.wifi_sta_control
    uci set firewall.wifi_sta_control='zone'
    uci set firewall.wifi_sta_control.name='wifi_sta'
    uci add_list firewall.wifi_sta_control.network='wifi_sta'
    uci set firewall.wifi_sta_control.input='REJECT'
    uci set firewall.wifi_sta_control.output='ACCEPT'
    uci set firewall.wifi_sta_control.forward='REJECT'

    # The development sidecar is deployed over SSH.  Explicitly enable the
    # built-in Dropbear service before its normal boot-time start, so port 22
    # is a real listener rather than merely a firewall exception.
    if [ -f /etc/config/dropbear ] && [ -x /etc/init.d/dropbear ]; then
        uci -q get dropbear.@dropbear[0] >/dev/null 2>&1 || uci add dropbear dropbear >/dev/null
        uci set dropbear.@dropbear[0].enable='1'
        uci set dropbear.@dropbear[0].Port='22'
        uci -q delete dropbear.@dropbear[0]._direct
        uci -q delete dropbear.@dropbear[0].DirectInterface
        uci -q delete dropbear.@dropbear[0].Interface
        uci add_list dropbear.@dropbear[0].Interface='wifi_sta'
        uci commit dropbear
        /etc/init.d/dropbear enable
        /etc/init.d/dropbear restart
    fi
    # Development sidecar validation uses the existing hash-verifying SSH
    # deployer on the trusted TP-LINK test LAN.  This is deliberately scoped
    # to that LAN and does not relax the station zone's default input policy.
    uci -q delete firewall.obdclaw_dev_sidecar_ssh
    uci set firewall.obdclaw_dev_sidecar_ssh='rule'
    uci set firewall.obdclaw_dev_sidecar_ssh.name='Allow-Development-Sidecar-SSH'
    uci set firewall.obdclaw_dev_sidecar_ssh.src='wifi_sta'
    uci set firewall.obdclaw_dev_sidecar_ssh.src_ip='192.168.0.0/24'
    uci set firewall.obdclaw_dev_sidecar_ssh.proto='tcp'
    uci set firewall.obdclaw_dev_sidecar_ssh.dest_port='22'
    uci set firewall.obdclaw_dev_sidecar_ssh.target='ACCEPT'

    uci -q delete firewall.obdclaw_tls_control
    uci set firewall.obdclaw_tls_control='rule'
    uci set firewall.obdclaw_tls_control.name='Allow-OBDclaw-TLS-Control'
    uci set firewall.obdclaw_tls_control.src='wifi_sta'
    uci set firewall.obdclaw_tls_control.src_ip='192.168.0.0/24'
    uci set firewall.obdclaw_tls_control.proto='tcp'
    uci set firewall.obdclaw_tls_control.dest_port='8443'
    uci set firewall.obdclaw_tls_control.target='ACCEPT'
    uci commit firewall
    /etc/init.d/firewall restart >/dev/null 2>&1 || true
fi

exit 0
