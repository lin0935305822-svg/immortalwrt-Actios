#!/bin/sh

# 1. ?? usb_rndis_gadget ? blue_led_fix ??? init ????
if [ -f /etc/init.d/usb_rndis_gadget ]; then
    /etc/init.d/usb_rndis_gadget enable >/dev/null 2>&1 || true
fi
# The legacy g_ether implementation competes with the ConfigFS gadget for
# the only USB device controller.  Keep the wrapper disabled at boot.
if [ -f /etc/init.d/usb_rndis ]; then
    /etc/init.d/usb_rndis disable >/dev/null 2>&1 || true
fi
if [ -f /etc/init.d/blue_led_fix ]; then
    /etc/init.d/blue_led_fix enable >/dev/null 2>&1 || true
fi

# blue_timer_guard is an older second writer for the same LED.
if [ -f /etc/init.d/blue_timer_guard ]; then
    /etc/init.d/blue_timer_guard disable >/dev/null 2>&1 || true
fi

# 2. ????? Shell ??????
rm -f /usr/bin/modem_led_status.sh /etc/init.d/modem_led_status /etc/modem_led_status.conf /etc/init.d/blue_timer_guard /etc/rc.d/S??modem_led_status /etc/rc.d/S??blue_timer_guard 2>/dev/null || true

# 3. ?? OpenWrt ?? /etc/init.d/led ???? (START=96)
if [ -f /etc/init.d/led ]; then
    /etc/init.d/led enable >/dev/null 2>&1 || true
fi

# 4. ???? system UCI ??
if command -v uci >/dev/null 2>&1 && [ -f /etc/config/system ]; then
    uci commit system >/dev/null 2>&1 || true
fi

# 5. ???? SPP ? A30M RFCOMM ??????
chmod 0755 /usr/bin/bluetooth_spp_manager.sh /usr/bin/rfcomm_a30m_bind.sh /etc/init.d/bluetooth_spp_service /etc/init.d/rfcomm_a30m /usr/bin/obdclaw_local_control_setup.sh /etc/init.d/obdclaw_local_control 2>/dev/null || true
chmod 0755 /www/cgi-bin/obdclaw-410.cgi /www/cgi-bin/obdclaw-runner.cgi 2>/dev/null || true
if [ -f /etc/init.d/bluetooth_spp_service ]; then
    /etc/init.d/bluetooth_spp_service enable >/dev/null 2>&1 || true
fi
if [ -f /etc/init.d/rfcomm_a30m ]; then
    /etc/init.d/rfcomm_a30m enable >/dev/null 2>&1 || true
fi

# The TLS material must exist before the HTTPS listener is started.  uci-defaults
# run after normal init service startup, so enable alone would defer uhttpd until
# a second reboot and leave the phone without a first-boot control endpoint.
if [ -f /etc/init.d/obdclaw_local_control ]; then
    /etc/init.d/obdclaw_local_control enable >/dev/null 2>&1 || true
    /etc/init.d/obdclaw_local_control start >/dev/null 2>&1 || true
fi
if [ -f /etc/init.d/uhttpd ]; then
    /etc/init.d/uhttpd enable >/dev/null 2>&1 || true
    /etc/init.d/uhttpd restart >/dev/null 2>&1 || true
fi
if [ -f /etc/init.d/obdclaw_uhttpd_watchdog ]; then
    /etc/init.d/obdclaw_uhttpd_watchdog enable >/dev/null 2>&1 || true
    /etc/init.d/obdclaw_uhttpd_watchdog start >/dev/null 2>&1 || true
fi

exit 0
