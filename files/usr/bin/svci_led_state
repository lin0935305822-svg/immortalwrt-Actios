#!/bin/sh

find_led() {
    for name in "$@"; do
        [ -d "/sys/class/leds/$name" ] && printf '%s\n' "/sys/class/leds/$name" && return 0
    done
    return 1
}

set_off() {
    [ -n "$1" ] || return 0
    echo none > "$1/trigger" 2>/dev/null || return 1
    echo 0 > "$1/brightness" 2>/dev/null || true
}

set_timer() {
    [ -n "$1" ] || return 1
    echo timer > "$1/trigger" 2>/dev/null || return 1
    echo "$2" > "$1/delay_on" 2>/dev/null || true
    echo "$3" > "$1/delay_off" 2>/dev/null || true
}

state="$1"
blue="$(find_led blue:wan led-b blue)"
red="$(find_led red:power led-r red)"

case "$state" in
    normal)
        rm -f /tmp/obdclaw_led_mode
        /etc/init.d/obdclaw_led_status restart >/dev/null 2>&1 || true
        ;;
    fault)
        echo fault > /tmp/obdclaw_led_mode
        set_off "$blue"
        set_timer "$red" 120 120 || exit 1
        ;;
    *)
        echo "Usage: $0 {normal|fault}" >&2
        exit 2
        ;;
esac

blue_trigger="$(cat "$blue/trigger" 2>/dev/null)"
red_trigger="$(cat "$red/trigger" 2>/dev/null)"
logger -t led_status "state=$state blue=${blue##*/} red=${red##*/} blue_trigger=$blue_trigger red_trigger=$red_trigger"
